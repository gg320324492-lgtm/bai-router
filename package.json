{
  "name": "bai-router",
  "productName": "B.AI Router",
  "version": "1.0.75",
  "private": true,
  "description": "B.AI 模型路由台：Claude Code / Claude 桌面版 外接模型的一键切换与中转",
  "author": "pc",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 scripts/attrib-atomic-test.mjs scripts/zen-go-tier-test.mjs scripts/zen-capability-probe-test.mjs scripts/empty-stream-diag-test.mjs scripts/oc-runtime-test.mjs scripts/oc-bridge-test.mjs scripts/oc-wiring-test.mjs scripts/oc-ui-test.mjs scripts/api-config-strict-test.mjs",
    "dist": "electron-builder --win nsis",
    "publish": "node scripts/publish.cjs",
    "postinstall": "node scripts/patch-updater.cjs",
    "test:oc-e2e": "set OC_E2E=1&& node --test --test-concurrency=1 scripts/oc-wiring-test.mjs"
  },
  "build": {
    "appId": "local.bai.router",
    "productName": "B.AI Router",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/main.js",
      "src/preload.js",
      "src/install-consistency.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/server",
        "to": "server",
        "filter": [
          "server.mjs",
          "panel-common.css",
          "providers.js",
          "provider.html",
          "failover.mjs",
          "panel-common.js",
          "diag.html",
          "config.defaults.json",
          "qoder-patch.mjs",
          "zen-probe.mjs",
          "oc-runtime.mjs",
          "oc-bridge.mjs",
          "oc-wiring.mjs",
          "oc-transport-info.mjs"
        ]
      },
      {
        "from": "src/server/cards",
        "to": "server/cards"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "cert/bai-router.cer",
        "to": "bai-router.cer"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "BARRouter-Setup-${version}.${ext}",
      "signtoolOptions": {
        "certificateFile": "cert/bai-router.pfx",
        "certificatePassword": "BaiRouter2026!",
        "timeStampServer": "http://timestamp.digicert.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "B.AI 路由台",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gg320324492-lgtm",
        "repo": "bai-router"
      }
    ],
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "^26.0.0"
  }
}
