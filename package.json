{
  "name": "bai-router",
  "productName": "B.AI Router",
  "version": "1.0.21",
  "private": true,
  "description": "B.AI 模型路由台：Claude Code / Claude 桌面版 外接模型的一键切换与中转",
  "author": "pc",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "publish": "node publish.cjs",
    "postinstall": "node scripts/patch-updater.cjs"
  },
  "build": {
    "appId": "local.bai.router",
    "productName": "B.AI Router",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/main.js",
      "src/preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/server",
        "to": "server",
        "filter": [
          "server.mjs",
          "ui.html",
          "diag.html",
          "config.defaults.json"
        ]
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "cert/bai-router.cer",
        "to": "bai-router.cer"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "BARRouter-Setup-${version}.${ext}",
      "signtoolOptions": {
        "certificateFile": "cert/bai-router.pfx",
        "certificatePassword": "BaiRouter2026!",
        "timeStampServer": "http://timestamp.sectigo.com"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "B.AI 路由台",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gg320324492-lgtm",
        "repo": "bai-router"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "44.0.0",
    "electron-builder": "^26.0.0"
  }
}
